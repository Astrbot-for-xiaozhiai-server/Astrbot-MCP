# Copy to .env and fill in what you need. Every value below is referenced from
# config.example.yaml via ${VAR} placeholders (docker compose reads this file
# automatically). Variables that are empty simply disable the related feature.

# --- MCP server HTTP auth (optional) --------------------------------------
ASTRBOT_MCP_AUTH_TOKEN=

# --- Local run overrides (ignored by the Docker image, which passes CLI flags)
# ASTRBOT_MCP_CONFIG=./config.yaml
# ASTRBOT_MCP_TRANSPORT=streamable-http
# ASTRBOT_MCP_HOST=127.0.0.1
# ASTRBOT_MCP_PORT=8765

# --- Search ---------------------------------------------------------------
# Only required when services.web_search.provider is tavily / bing / searxng.
TAVILY_API_KEY=
BING_SEARCH_API_KEY=
SEARXNG_BASE_URL=

# --- GitHub ---------------------------------------------------------------
# A fine-grained token with only the scopes you need is strongly recommended.
GITHUB_TOKEN=

# --- Mail -----------------------------------------------------------------
MAIL_PASSWORD=

# --- Knowledge base embeddings (optional) ---------------------------------
OPENAI_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
